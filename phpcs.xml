<?xml version="1.0"?>
<ruleset name="TokenLink SSO Login for Zendesk">
	<description>WordPress Coding Standards for TokenLink SSO Login for Zendesk</description>

	<!-- What to scan -->
	<file>.</file>

	<!-- Exclude common directories -->
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/tests/*</exclude-pattern>

	<!-- Use WordPress coding standards -->
	<rule ref="WordPress">
		<!-- Exclude WordPress-specific naming rules for third-party JWT library -->
		<!-- This is a third-party library (Firebase JWT) that uses its own coding conventions -->
		<exclude-pattern>*/includes/jwt/*</exclude-pattern>

		<!-- Explicitly exclude specific WordPress naming sniffs for JWT library -->
		<rule ref="WordPress.Files.FileName">
			<exclude-pattern>*/includes/jwt/*</exclude-pattern>
		</rule>
		<rule ref="WordPress.NamingConventions.ValidFunctionName">
			<exclude-pattern>*/includes/jwt/*</exclude-pattern>
		</rule>
		<rule ref="WordPress.NamingConventions.ValidVariableName">
			<exclude-pattern>*/includes/jwt/*</exclude-pattern>
		</rule>
	</rule>

	<!-- Apply basic Generic sniffs to JWT library for syntax/security -->
	<rule ref="Generic.PHP.ForbiddenFunctions">
		<include-pattern>*/includes/jwt/*</include-pattern>
	</rule>
	<rule ref="Generic.PHP.NoSilencedErrors">
		<include-pattern>*/includes/jwt/*</include-pattern>
	</rule>
	<rule ref="Generic.CodeAnalysis.EmptyStatement">
		<include-pattern>*/includes/jwt/*</include-pattern>
	</rule>

	<!-- Check for PHP cross-version compatibility -->
	<config name="testVersion" value="7.4-"/>

	<!-- Show progress and sniff codes -->
	<arg value="ps"/>

	<!-- Use colors in output -->
	<arg name="colors"/>

	<!-- Only check PHP files -->
	<arg name="extensions" value="php"/>

	<!-- Show sniff codes in all reports -->
	<arg value="ns"/>
</ruleset>
